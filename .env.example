# Gerbang Edukasi — environment template
# Copy to `.env.local` and isi nilai dari dashboard Supabase / Vercel.

# --- Supabase (backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pepper untuk hash kode aktivasi (server-side; jangan expose ke klien)
ACTIVATION_CODE_PEPPER=
# Pepper untuk hash kode enrollment (harus sama dengan Worker)
ENROLLMENT_CODE_PEPPER=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://gerbangedukasi.id